{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/evidence",
    "name": "Evidence",
    "sourceRepository": "https://github.com/just-every/run-evidence",
    "license": "MIT",
    "verifyWorkflow": "verify.yml",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile && pnpm exec rer install",
      "build": "pnpm run build",
      "verify": "pnpm exec rer check --profile first-party && pnpm check:deployment-spec && pnpm run verify",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow docs/BACKUP-RESTORE.md and docs/OPERATIONS.md: retain the exact source, private configuration and complete Evidence custody archive; restore into a fresh empty installation, compare records and attachment bytes, and verify owner sign-in before routing traffic. Preserve all applied migration names and bytes."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ],
      "guidanceFiles": [
        "AGENTS.md",
        "CONTRACT.md",
        "OPERATIONS.md"
      ],
      "testPatterns": [
        "tests/*.mjs"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@34cf6c23b5cb86eff0068049bc39feeb38c8ffa9",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_LOCAL",
        "AUTH_ORIGIN",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID",
        "OWNER_EMAIL"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN",
        "MAIL_API_KEY"
      ],
      "migrationPrefix": "",
      "healthPath": "/health",
      "recovery": "Follow docs/BACKUP-RESTORE.md and docs/OPERATIONS.md: retain the exact source, private configuration and complete Evidence custody archive; restore into a fresh empty installation, compare records and attachment bytes, and verify owner sign-in before routing traffic. Preserve all applied migration names and bytes.",
      "providerEffects": [
        "outbound-mail"
      ],
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      },
      "surfaces": {
        "app": {
          "path": "/signin",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false
          }
        }
      }
    }
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  },
  "edition": {
    "manifestFile": "edition.json",
    "componentId": "just-every/evidence"
  }
}
