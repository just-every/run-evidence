{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evidence-foundation-evidence",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundation",
      "database_id": "local-foundation-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "EXHIBITS",
      "bucket_name": "evidence-exhibits"
    }
  ],
  "vars": {
    "AUTH_LOCAL": "false",
    "AUTH_ORIGIN": "",
    "MAIL_PROVIDER": "resend",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": ""
  }
}
