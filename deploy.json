{
  "version": 1,
  "project": "evidence-foundation/evidence",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": ""
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "MAIL_PROVIDER",
      "environment": "MAIL_PROVIDER",
      "verifyStandIn": "sendgrid"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM",
      "verifyStandIn": "owner@example.com"
    }
  ],
  "r2": [
    {
      "binding": "EXHIBITS"
    }
  ],
  "platforms": [
    "workers",
    "container"
  ]
}
